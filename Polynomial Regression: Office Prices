import numpy as np
from itertools import combinations_with_replacement

def poly_features(X, degree):
    n_samples, n_features = X.shape
    features = [np.ones(n_samples)]
    
    for d in range(1, degree + 1):
        for comb in combinations_with_replacement(range(n_features), d):
            features.append(np.prod(X[:, comb], axis=1))
    
    return np.vstack(features).T

# Input
F, N = map(int, input().split())

X = []
y = []

for _ in range(N):
    row = list(map(float, input().split()))
    X.append(row[:-1])
    y.append(row[-1])

X = np.array(X)
y = np.array(y)

# Polynomial transform
X_poly = poly_features(X, 3)

# Normal equation
theta = np.linalg.pinv(X_poly.T.dot(X_poly)).dot(X_poly.T).dot(y)

# Predictions
T = int(input())

for _ in range(T):
    test = np.array([list(map(float, input().split()))])
    test_poly = poly_features(test, 3)
    pred = test_poly.dot(theta)
    print(round(pred[0], 2))
