import sys

# Simple dictionary (expand if needed)
WORDS = set([
    "going", "to", "china", "who", "was", "the", "first", "president",
    "of", "india", "winner", "match", "food", "in", "america"
])

# Levenshtein Distance
def edit_distance(a, b):
    dp = [[0]*(len(b)+1) for _ in range(len(a)+1)]
    
    for i in range(len(a)+1):
        dp[i][0] = i
    for j in range(len(b)+1):
        dp[0][j] = j
        
    for i in range(1, len(a)+1):
        for j in range(1, len(b)+1):
            if a[i-1] == b[j-1]:
                dp[i][j] = dp[i-1][j-1]
            else:
                dp[i][j] = 1 + min(
                    dp[i-1][j],
                    dp[i][j-1],
                    dp[i-1][j-1]
                )
    return dp[-1][-1]

# Find best correction
def correct_word(word):
    if word in WORDS:
        return word
    
    best_word = word
    min_dist = float('inf')
    
    for w in WORDS:
        dist = edit_distance(word, w)
        if dist < min_dist:
            min_dist = dist
            best_word = w
            
    return best_word

# Main
n = int(input().strip())

for _ in range(n):
    query = input().strip().lower()
    words = query.split()
    
    corrected = []
    for w in words:
        corrected.append(correct_word(w))
    
    print(" ".join(corrected))
