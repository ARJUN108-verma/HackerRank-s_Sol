import math

# Given mean
lam_1 = 3  # for 1 minute

# (a) P(X = 0) for 1 minute
p_no_calls = math.exp(-lam_1)

# (b) For 2 minutes, mean becomes 6
lam_2 = 6

# P(X >= 2) = 1 - P(0) - P(1)
p_at_least_2 = 1 - (math.exp(-lam_2) * (1 + lam_2))

# Print answers rounded to 3 decimal places
print(f"{p_no_calls:.3f}")
print(f"{p_at_least_2:.3f}")
