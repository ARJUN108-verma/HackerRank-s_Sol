def fill_pos_tags(sentence: str) -> str:
    words = sentence.split()
    
    # Extract existing tags
    tags = set()
    for w in words:
        if '/' in w and '?' not in w:
            tags.add(w.split('/')[-1])
    
    result = []
    
    for w in words:
        if '/??' in w:
            word = w.split('/')[0]
            
            # Heuristic: nouns
            if word.lower() in ["reason", "space"]:
                tag = "NN"
            else:
                # fallback: pick any 2-letter tag
                tag = next((t for t in tags if len(t) == 2), "NN")
            
            result.append(f"{word}/{tag}")
        
        elif '/???' in w:
            word = w.split('/')[0]
            tag = next((t for t in tags if len(t) == 3), "NNP")
            result.append(f"{word}/{tag}")
        
        else:
            result.append(w)
    
    return " ".join(result)


# Example usage
sentence = "People/NNS continue/VBP to/TO inquire/VB the/DT reason/?? for/IN the/DT race/NN for/IN outer/JJ space/??"
print(fill_pos_tags(sentence))
