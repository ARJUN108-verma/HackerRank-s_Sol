import math

# Poisson PMF
def poisson_pmf(lmbda, k):
    return (math.exp(-lmbda) * (lmbda ** k)) / math.factorial(k)

# Given mean per page
lmbda = 1.2

# 1) Page 10 has exactly 2 errors
p1 = poisson_pmf(lmbda, 2)

# 2) Page 1 has less than 3 errors (0,1,2)
p2 = sum(poisson_pmf(lmbda, k) for k in range(3))

# 3) First 10 pages total 5 errors (lambda = 12)
p3 = poisson_pmf(10 * lmbda, 5)

# 4) First 40 pages have at least 3 errors (lambda = 48)
# P(X >= 3) = 1 - P(0) - P(1) - P(2)
lmbda_40 = 40 * lmbda
p4 = 1 - sum(poisson_pmf(lmbda_40, k) for k in range(3))

# Print results (3 decimal places)
print(f"{p1:.3f}")
print(f"{p2:.3f}")
print(f"{p3:.3f}")
print(f"{p4:.3f}")
