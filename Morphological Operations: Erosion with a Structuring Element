B = [
    "00110",
    "00110",
    "00110",
    "11111"
]

rows = len(B)
cols = len(B[0])

result = []

for r in range(rows):
    row = []
    for c in range(cols):
        if (r > 0 and r < rows - 1 and
            B[r-1][c] == '1' and
            B[r][c] == '1' and
            B[r+1][c] == '1'):
            row.append('1')
        else:
            row.append('0')
    result.append(''.join(row))

for row in result:
    print(row)
